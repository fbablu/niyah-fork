rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // users/{uid}
    // -------------------------------------------------------------------------
    // Any signed-in user can read any user doc (public profiles, partner
    // lookup, referral flows all need cross-user reads).
    //
    // Full write access is owner-only. Cross-user reputation updates are
    // handled exclusively by Cloud Functions (awardReferral) using the
    // admin SDK, which bypasses these rules entirely.
    match /users/{uid} {
      allow read: if request.auth != null;

      // Owner: full write access (profile setup, profile updates) EXCEPT
      // tamper-resistant fields written only by Cloud Functions:
      //   - legal acceptance (acceptLegalTerms CF)
      //   - KYC / Stripe account fields (createConnectAccount + linkBankAccount CFs)
      //   - stripeCustomerId — server-issued; forging another user's customer
      //     id would expose their saved payment methods via PaymentSheet.
      //   - forgiveness + promo flags (handleSessionForfeit, maybeAwardFinalsPromo)
      //   - phone / email — locked after initial create to block account-merge
      //     phone-squat: an attacker setting phone=victim's-number would
      //     otherwise be queueable as a merge target. Mutation goes through a
      //     Cloud Function that re-verifies via OTP or email link.
      //   - mergedInto / mergedAt — written exclusively by mergeDuplicateUsers
      //   - top-level stat fields (completedSessions, totalSessions,
      //     currentStreak, longestStreak, totalEarnings) — server-authoritative
      //     and read by withdrawal-eligibility gate. Client display sync uses
      //     the nested `stats` map instead, which stays writable.
      //   - reputation — public social-proof signal; forgery would let users
      //     claim levels they haven't earned.
      //   - referredByUid / referralAwardedAt — written only by awardReferral.
      allow write: if request.auth != null
        && request.auth.uid == uid
        && (!('firstName' in request.resource.data.keys())
            || (request.resource.data.firstName is string
                && request.resource.data.firstName.size() <= 50))
        && (!('lastName' in request.resource.data.keys())
            || (request.resource.data.lastName is string
                && request.resource.data.lastName.size() <= 50))
        && (!('displayName' in request.resource.data.keys())
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        && (!('name' in request.resource.data.keys())
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 120))
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny([
                'legalAcceptanceVersion', 'legalAcceptedAt', 'ageAttested18',
                'stripeAccountId', 'stripeAccountStatus', 'stripeKycProvidedAt',
                'stripeCustomerId',
                'legalFirstName', 'legalLastName',
                'linkedBank', 'plaidAccessToken', 'plaidItemId', 'plaidAccountId',
                'firstSurrenderForgiven', 'firstSurrenderForgivenAt',
                'finalsPromoAwarded', 'finalsPromoAwardedAt',
                'phone', 'email',
                'mergedInto', 'mergedAt',
                'completedSessions', 'totalSessions',
                'currentStreak', 'longestStreak', 'totalEarnings',
                'reputation',
                'referredByUid', 'referralAwardedAt'
              ]);

      // Initial profile creation (no existing doc — resource is null).
      // `reputation` is intentionally allowed here because saveUserProfile
      // seeds the default reputation object (score:50, level:sapling, …) on
      // first sign-up. Post-create reputation writes are blocked above.
      // Length caps on display strings prevent storage/bandwidth abuse — a
      // user otherwise could write a megabyte-long displayName that bloats
      // every cross-user read (contact discovery, partner lookup).
      allow create: if request.auth != null
        && request.auth.uid == uid
        && (!('firstName' in request.resource.data.keys())
            || (request.resource.data.firstName is string
                && request.resource.data.firstName.size() <= 50))
        && (!('lastName' in request.resource.data.keys())
            || (request.resource.data.lastName is string
                && request.resource.data.lastName.size() <= 50))
        && (!('displayName' in request.resource.data.keys())
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 100))
        && (!('name' in request.resource.data.keys())
            || (request.resource.data.name is string
                && request.resource.data.name.size() <= 120))
        && !request.resource.data.keys().hasAny([
             'legalAcceptanceVersion', 'legalAcceptedAt', 'ageAttested18',
             'stripeAccountId', 'stripeAccountStatus', 'stripeKycProvidedAt',
             'stripeCustomerId',
             'legalFirstName', 'legalLastName',
             'linkedBank', 'plaidAccessToken', 'plaidItemId', 'plaidAccountId',
             'firstSurrenderForgiven', 'firstSurrenderForgivenAt',
             'finalsPromoAwarded', 'finalsPromoAwardedAt',
             // phone/email are PII — never stored on the public users doc. The
             // owner-only userPrivate contact index (written by acceptLegalTerms
             // from auth-verified values) is the only place they live now. This
             // also blocks a client from seeding email=victim@x on create to be
             // impersonated in contact discovery.
             'phone', 'email',
             'completedSessions', 'totalSessions',
             'currentStreak', 'longestStreak', 'totalEarnings',
             'referredByUid', 'referralAwardedAt'
           ]);
    }

    // -------------------------------------------------------------------------
    // userPrivate/{uid}
    // -------------------------------------------------------------------------
    // Owner-readable, server-only-writable mirror of sensitive fields that
    // were historically on users/{uid} where every signed-in user could read
    // them. Plaid access tokens, Stripe Connect account ID, Stripe customer
    // ID, KYC name fields, legal acceptance metadata all live here now.
    //
    // Writes happen exclusively via Cloud Functions using the admin SDK
    // (linkBankAccount, createConnectAccount, acceptLegalTerms,
    // migrateSensitiveFieldsToPrivate, etc.) so the rule denies all client
    // writes. Owner reads are allowed so the UI can show bank-link state and
    // legal-acceptance status without round-tripping through a CF.
    match /userPrivate/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // userPushTokens/{uid}
    // -------------------------------------------------------------------------
    // FCM device tokens. Previously stored as a `fcmTokens` array on
    // users/{uid} which was readable by any signed-in user — a defense-in-
    // depth violation. Moved to a dedicated collection with neither read nor
    // write permitted to clients. The `registerPushToken` CF arrayUnions a
    // verified token; `sendPushToUser`/`sendPushToUsers` read via admin SDK.
    match /userPushTokens/{uid} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // wallets/{uid}
    // -------------------------------------------------------------------------
    // Owner-read-only. Client writes are restricted to initial creation with a
    // zero balance (saveUserProfile initializes the wallet once on first signup).
    // All balance mutations happen server-side via Cloud Functions, which use
    // the admin SDK and bypass these rules entirely.
    match /wallets/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      // Allow initial wallet creation only — balance must start at zero.
      // Enforce numeric types to prevent string "0" bypassing downstream checks.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.balance is number
        && request.resource.data.balance == 0
        && request.resource.data.pendingBalance is number
        && request.resource.data.pendingBalance == 0
        // Bucket fields must start at zero if the client sets them at all,
        // otherwise a client could mint nonzero withdrawable buckets on create
        // (the buckets are summed into withdrawable funds server-side).
        && (!('depositedBalance' in request.resource.data) || request.resource.data.depositedBalance == 0)
        && (!('earnedBalance' in request.resource.data) || request.resource.data.earnedBalance == 0)
        && (!('bonusBalance' in request.resource.data) || request.resource.data.bonusBalance == 0)
        && (!('creditBalance' in request.resource.data) || request.resource.data.creditBalance == 0);

      // No client-side updates or deletes — handled exclusively by Cloud Functions.
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // userFollows/{uid}
    // -------------------------------------------------------------------------
    // Any signed-in user can read follows docs (social graph is public).
    //
    // follow/unfollow operations are handled by Cloud Functions (followUser,
    // unfollowUser) using the admin SDK, which bypasses these rules.
    // Owner can still write their own doc for backwards compatibility.
    match /userFollows/{uid} {
      allow read: if request.auth != null;

      // All follow/unfollow writes handled by Cloud Functions (admin SDK).
      // Previously allowed owner writes for backwards compatibility — removed
      // because it let users forge follower arrays directly.
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // sessions/{sessionId}
    // -------------------------------------------------------------------------
    // Session documents track solo focus sessions. Created exclusively by the
    // `createSoloSession` Cloud Function (admin SDK) which atomically debits
    // the wallet and writes the doc — client-side create is denied so an
    // attacker cannot mint a session with a forged stakeAmount/endsAt and
    // immediately complete it for an arbitrary payout.
    //
    // Owner can update their own session for status transitions (complete /
    // surrender) so the UI can mark a finished session before the next CF
    // call lands. handleSessionComplete / handleSessionForfeit use admin SDK
    // for authoritative balance mutations.
    match /sessions/{sessionId} {
      // Owner can read their own sessions
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      // Server-only create. Use createSoloSession Cloud Function.
      allow create: if false;

      // Owner can update their own sessions — restricted to status transition
      // fields only. Financial fields (stakeAmount, potentialPayout, endsAt,
      // cadence) remain immutable. Cloud Functions use admin SDK for
      // authoritative balance mutations and can write any field.
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'completedAt', 'updatedAt', 'violationCount']);

      // No client-side deletes
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // rateLimits/{docId}
    // -------------------------------------------------------------------------
    // Written exclusively by Cloud Functions (admin SDK) for server-side
    // rate limiting. No client access — explicit deny for defense-in-depth.
    match /rateLimits/{docId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // revenue/{docId}
    // -------------------------------------------------------------------------
    // Written by Cloud Functions when sessions are forfeited. No client access.
    match /revenue/{docId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // transactions/{docId}
    // -------------------------------------------------------------------------
    // Written by Cloud Functions for deposit/withdrawal/payout records.
    // Owner can read their own transactions.
    match /transactions/{docId} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // groupSessions/{sessionId}
    // -------------------------------------------------------------------------
    // Participants can read their own group sessions. All writes happen
    // exclusively via Cloud Functions (admin SDK) to enforce server-authoritative
    // session lifecycle, payout calculations, and stake management.
    match /groupSessions/{sessionId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.participantIds;

      // No client-side writes — all managed by Cloud Functions
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // groupInvites/{inviteId}
    // -------------------------------------------------------------------------
    // Recipients can read invites sent to them. Proposers can read invites
    // they sent. All writes (create, accept, decline, expire) happen via
    // Cloud Functions to enforce stake deduction and session state transitions.
    match /groupInvites/{inviteId} {
      allow read: if request.auth != null
        && (resource.data.toUserId == request.auth.uid
            || resource.data.fromUserId == request.auth.uid);

      // No client-side writes — all managed by Cloud Functions
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // analytics_events/{eventId}
    // -------------------------------------------------------------------------
    // Authenticated users append their own milestone events. No reads — the
    // aggregateDailyMetrics Cloud Function reads server-side. userId may be
    // null for pre-auth events (e.g. install/app_open before sign-in).
    match /analytics_events/{eventId} {
      allow read: if false;
      // Shape-locked create: only the four fields the client analytics writer
      // emits (name, userId, props, createdAt), a bounded event name, and a
      // userId that is null or the caller's own uid. Without the field
      // allowlist + size cap any signed-in user could write unbounded ~1 MiB
      // docs of arbitrary shape — storage/billing abuse that also pollutes the
      // aggregateDailyMetrics rollup.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['name', 'userId', 'props', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 64
        && (request.resource.data.userId == null
            || request.resource.data.userId == request.auth.uid);
      allow update, delete: if false;
    }

    // -------------------------------------------------------------------------
    // metrics/{YYYY-MM-DD}
    // -------------------------------------------------------------------------
    // Daily rollup written by aggregateDailyMetrics. Readable by any signed-in
    // user (for an in-app dashboard later). No client writes.
    match /metrics/{dateId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // config/featureFlags
    // -------------------------------------------------------------------------
    // Public read-only server-controlled kill switches. Fields:
    //   acceptingDeposits, acceptingWithdrawals, groupSessionsEnabled,
    //   soloSessionsEnabled
    // Any authenticated user can read so the client can honor a toggle live.
    // Writes are console-only (admin console, or gcloud) — never client.
    match /config/featureFlags {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // config/serverFlags
    // -------------------------------------------------------------------------
    // Server-only operational config (billing kill-switch armed state, finals
    // promo cents, other money-path knobs). Read by Cloud Functions via the
    // admin SDK; NOT client-readable (unlike featureFlags) so operational
    // posture isn't exposed to clients. Set/toggle via the Firebase console
    // (console writes use admin privileges and bypass these rules).
    match /config/serverFlags {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // userMerges/{newUid}
    // -------------------------------------------------------------------------
    // Account-link merge queue. Written exclusively by the `requestAccountMerge`
    // Cloud Function via admin SDK (which bypasses these rules). No client
    // writes — even narrow client write rules opened a phone-squat vector
    // where an attacker could enqueue a merge against a victim's verified
    // contact. The CF re-verifies the shared contact via auth admin SDK
    // before consuming the queue.
    //
    // Owner can read their own pending merge record so the UI can show
    // "linking your accounts…" state.
    match /userMerges/{newUid} {
      allow read: if request.auth != null && request.auth.uid == newUid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // migrations/{date}/entries/{newUid}
    // -------------------------------------------------------------------------
    // Audit log of completed merges. Written by mergeDuplicateUsers admin
    // CF. No client access — these are operator-only forensic records.
    match /migrations/{date} {
      allow read, write: if false;
      match /entries/{newUid} {
        allow read, write: if false;
      }
    }

    // -------------------------------------------------------------------------
    // walletAudits/{uid_date}
    // -------------------------------------------------------------------------
    // Wallet-balance drift report from reconcileWalletBalances. Operator-only.
    match /walletAudits/{auditId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // deletions/{uid}
    // -------------------------------------------------------------------------
    // Audit log + held-earnings record produced by the `deleteAccount` Cloud
    // Function. Server-only writes (admin SDK bypasses these rules). No
    // client access — the doc is operator-only forensic state, never read
    // by the app (the calling user's account is gone the moment the row
    // lands).
    match /deletions/{uid} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Default deny
    // -------------------------------------------------------------------------
    // Any collection not explicitly matched above is denied by default.
    // This covers future collections (groupSessions, groupInvites, etc.)
    // until explicit rules are added for them.
  }
}
